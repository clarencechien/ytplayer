{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ytplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  // ⚠ 模型選擇的單一事實來源在這裡：git 部署會用本檔的 vars 蓋掉 dashboard 的明文變數
  //（只有 Secret 倖存）— 在 dashboard 改模型會被下一次部署踩回來（2026-08-13 帳單事故成因之一）。
  // gemini-3.5-flash + thinking 實質關閉 = 四組同片對決的贏家（docs/model-experiment.md）：
  // 0 缺句、品質同思考版、tokens -31% 且輸出佔比從 3~4 倍降到 1/3。
  // 3.6-flash 關思考後會「譯文對錯句」（禁用）；3.5-flash-lite 缺 27 句（只配重跑用 ?model= 指定）。
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash" },
  // cron = 零成本看門狗（migration.md §2）：只掃描 + enqueue，永不碰 LLM。
  // 2026-08-13 成本事故的三個修法（分段可續跑、嘗試上限、開工即寫狀態）都已落在 queue 步驟裡。
  "triggers": { "crons": ["*/5 * * * *"] },
  "r2_buckets": [
    { "binding": "SUBS", "bucket_name": "ytplayer-subs" }
  ],
  // Queues（Workers Paid）：pipeline 拆成有界小步自我續鏈；先在 Dashboard 建 queue `ytplayer-jobs`。
  // max_retries 3 = 保險絲第 2 層的底；max_concurrency 2 = 花費節流（同時最多兩步在燒）
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "ytplayer-jobs" }],
    "consumers": [{ "queue": "ytplayer-jobs", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 2 }]
  }
}
